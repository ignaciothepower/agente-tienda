# Copia este fichero como .env y rellena tus valores. El .env NUNCA se sube a GitHub (esta en .gitignore).
# Neon · console.neon.tech -> tu proyecto -> Connect -> connection string (la misma de la S4)
DATABASE_URL=postgresql://usuario:contrasena@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# LangFuse Cloud · Settings -> API Keys (las mismas de la S3)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
# Servidor MCP de la tienda (S10-S12): en local http://localhost:8000, en AWS http://IP-DE-LA-EC2:8000
MCP_URL=http://localhost:8000
MODELO=llama3.1
